{
  "name": "DgmCraft — Minecraft-like sandbox",
  "short_name": "DgmCraft",
  "description": "Воксельная песочница на Three.js: Survival, Creative, Education, redstone и сохранение мира. Работает офлайн.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#1f2a1c",
